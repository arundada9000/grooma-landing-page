# EditorConfig

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown / plain text
[*.{md,mdx,txt}]
trim_trailing_whitespace = false

# JSON / YAML
[*.{json,jsonc,yml,yaml}]
indent_size = 2

# CSS / SCSS
[*.{css,scss}]
indent_size = 2

# Shell / Windows batch
[*.ps1]
end_of_line = crlf
